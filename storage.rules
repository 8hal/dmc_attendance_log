rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 춘백 출석 사진 — 서버(Admin SDK)만 쓰기. 읽기는 download token URL로.
    match /chunbaek/attendance/{seasonId}/{slotId}/{fileName} {
      allow read: if fileName.matches('.*\\.jpg$');
      allow write: if false;
    }
    // 춘백 시즌 마감 기록증 — 서버(Admin SDK)만 쓰기. 읽기는 download token URL로.
    match /chunbaek/season-results/{seasonId}/{fileName} {
      allow read: if fileName.matches('.*\\.jpg$');
      allow write: if false;
    }
  }
}
